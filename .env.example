# Image to run (replace OWNER/REPO with your GitHub org + repository, lowercase)
STUDIO_OS_IMAGE=ghcr.io/OWNER/REPO:latest

# Host port for the Studio OS UI
STUDIO_OS_PORT=8080

# The Docker network your existing Ollama container is attached to.
#   docker network ls
#   docker inspect -f '{{json .NetworkSettings.Networks}}' <ollama-container-name>
OLLAMA_NETWORK=ollama_default

# How Studio OS reaches Ollama from inside Docker.
# Use the Ollama CONTAINER NAME as the hostname.
OLLAMA_URL=http://ollama:11434

# ---- Accounts ----
# The first owner account, created on first start only. If you leave the
# password blank a random one is generated and printed in the container logs
# (docker compose logs studio-os).
STUDIO_ADMIN_EMAIL=admin@studio.local
STUDIO_ADMIN_PASSWORD=change-me-please
STUDIO_ADMIN_NAME=Studio Owner

# 32+ random characters used to encrypt session cookies. Optional — generated
# into the data volume when unset. Changing it signs everyone out.
# SESSION_SECRET=

# Set true only if you serve Studio OS over HTTPS.
STUDIO_SECURE_COOKIES=false
